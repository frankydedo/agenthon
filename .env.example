# Copia questo file in .env (che NON va mai committato) e compila.
#
# LLM_PROVIDER:
#   mock          = risposte registrate (default): gratis, offline, sempre uguali
#   openai_compat = un modello vero tramite API compatibile con il formato OpenAI
LLM_PROVIDER=mock

# --- Solo per openai_compat: scegli UN blocco e togli i commenti -------------------------
# I nomi dei modelli sono esempi: verificate quelli disponibili sul sito del fornitore.

# Google Gemini (chiave gratuita da Google AI Studio)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=...

# Mistral (azienda UE, dati in UE)
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-large-latest
# LLM_API_KEY=...

# Ollama in locale (nessun dato esce dal computer; serve un modello che supporti i tool)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=
